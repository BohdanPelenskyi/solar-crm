generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT
  PROPOSAL_SENT
  IN_PROGRESS
  INSTALLATION
  COMPLETED
  CANCELED
}

enum ContactRole {
  OWNER
  ACCOUNTANT
  ELECTRICIAN
  MANAGER
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum FileCategory {
  PROPOSAL
  PROJECT_DOCUMENT
  FINANCIAL_DOCUMENT
  OTHER
}

enum MediaType {
  PHOTO
  VIDEO
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum UserRole {
  ADMIN
  WORKER
  VIEWER
}

enum EquipmentStatus {
  ORDERED
  PAID
  IN_STOCK
  ON_SITE
}

model Project {
  id       Int           @id @default(autoincrement())
  name     String
  status   ProjectStatus @default(DRAFT)
  source               String?
  brigade             String?
  responsiblePrimary  String?
  responsibleSecondary String?
  location             String?
  notes                String?

  contacts     ProjectContact[]
  transactions FinancialTransaction[]
  files        ProjectFile[]
  media        ProjectMedia[]
  tasks        ProjectTask[]
  equipment    ProjectEquipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([name])
}

model ProjectContact {
  id        Int         @id @default(autoincrement())
  projectId Int
  fullName  String
  phone     String
  role      ContactRole @default(OTHER)
  position  String?
  isPrimary Boolean     @default(false)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model FinancialTransaction {
  id            Int             @id @default(autoincrement())
  projectId     Int
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  counterparty  String?
  paymentMethod PaymentMethod   @default(BANK_TRANSFER)
  accountName   String?
  occurredAt    DateTime
  comment       String?
  receiptPath   String?
  attachments   TransactionAttachment[]
  createdAt     DateTime        @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type])
  @@index([occurredAt])
}

model TransactionAttachment {
  id            Int      @id @default(autoincrement())
  transactionId Int
  originalName   String
  storageKey     String
  mimeType       String
  size           Int
  createdAt      DateTime @default(now())

  transaction FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

model ProjectEquipment {
  id        Int             @id @default(autoincrement())
  projectId Int
  name      String
  status    EquipmentStatus @default(ORDERED)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

model ProjectFile {
  id           Int          @id @default(autoincrement())
  projectId    Int
  category     FileCategory
  originalName String
  storageKey   String
  mimeType     String
  size         Int
  isFinal      Boolean      @default(false)
  uploadedAt   DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, category])
}

model ProjectMedia {
  id              Int       @id @default(autoincrement())
  projectId       Int
  type            MediaType
  originalName    String
  storageKey      String
  thumbnailKey    String?
  mimeType        String
  size            Int
  durationSeconds Int?
  createdAt       DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type])
}

model ProjectTask {
  id        Int     @id @default(autoincrement())
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  fullName     String
  role         UserRole @default(VIEWER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
